# Copy to .env and fill in ONE of these, then run:
#   flutter run --dart-define-from-file=.env
#
# Gemini wins when both are present: reading a plan is transcription, not
# reasoning, so the free tier does the job. Get a key at aistudio.google.com.
GEMINI_API_KEY=

# The paid alternative. Roughly $0.13-$0.62 per imported plan depending on the
# model. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
